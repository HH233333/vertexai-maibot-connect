{
  "manifest_version": 2,
  "id": "local.vertexai-maibot-connect",
  "version": "0.1.0",
  "name": "VertexAI-MaiBot-connect-plugin",
  "description": "Google Cloud Vertex AI 官方接入插件，提供多模态对话、VLM 识图、语音识别与向量嵌入",
  "author": {
    "name": "MaiBot Contributor",
    "url": "https://github.com/Mai-with-u"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Mai-with-u/maibot"
  },
  "host_application": {
    "min_version": "1.3.14",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "google-genai",
      "version_spec": ">=1.0.0"
    },
    {
      "type": "python_package",
      "name": "google-auth",
      "version_spec": ">=2.0.0"
    }
  ],
  "plugin_type": "provider",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "cloud"
    }
  },
  "capabilities": [
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "llm_providers": [
    {
      "client_type": "vertex_connect",
      "name": "Vertex AI Connect",
      "description": "Google Cloud Vertex AI 官方 SDK 接入通道",
      "version": "0.1.0"
    }
  ]
}
